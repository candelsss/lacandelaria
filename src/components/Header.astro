---
const pages = [
	{ name: "Manifiesto", href: "/manifiesto" },
	{ name: "Carta", href: "/carta" },
	{ name: "Packs", href: "/packs" },
	{ name: "Eventos", href: "/eventos" },
	{ name: "Contacto", href: "/contacto" },
];
---

<header class="site-header">
	<button
		class="menu-toggle"
		id="menu-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="menu-list"
	>
		Menú
	</button>
	<nav aria-label="Principal">
		<ul class="menu-list" id="menu-list">
			{
				pages.map((page, i) => (
					<li>
						<a href={page.href}>{page.name}</a>
						{i < pages.length - 1 && <span class="sep" aria-hidden="true">,</span>}
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.menu-toggle {
		display: block;
		width: 100%;
		padding: 1rem;
		background: none;
		border: none;
		outline: none;
		-webkit-tap-highlight-color: transparent;
		user-select: none;
		font: inherit;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--txt);
		text-align: right;
		cursor: pointer;
	}

	.menu-toggle:focus-visible {
		outline: 1px solid var(--txt);
		outline-offset: -4px;
	}

	.menu-list {
		display: none;
		flex-direction: column;
		list-style: none;
		margin: 0;
		padding: 0 1rem 1rem;
	}

	.menu-list.open {
		display: flex;
	}

	.menu-list li {
		display: flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.4rem 0;
	}

	.menu-list a {
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-size: 0.9rem;
		color: var(--txt);
		text-decoration: none;
	}

	.sep {
		display: none;
		color: var(--txt);
	}

	@media (min-width: 768px) {
		.menu-toggle {
			display: none;
		}

		.menu-list {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: flex-end;
			gap: 0.4em;
			padding: 1rem;
		}

		.menu-list.open {
			display: flex;
		}

		.sep {
			display: inline;
		}
	}
</style>

<script>
	const toggle = document.getElementById("menu-toggle");
	const list = document.getElementById("menu-list");

	toggle?.addEventListener("click", () => {
		const expanded = toggle.getAttribute("aria-expanded") === "true";
		toggle.setAttribute("aria-expanded", String(!expanded));
		list?.classList.toggle("open");
	});
</script>
